# SQLite (persistent container volume: /app/data/crm.db)
DB_PATH="./data/crm.db"
# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical CRM origin, no path/query; use HTTPS in production.
CRM_PUBLIC_URL="http://localhost:3000"
# Storefront SERVER credential: openssl rand -hex 32 (>=32 characters).
# Blank disables /api/storefront/v1/*. Never NEXT_PUBLIC_* or browser code.
STOREFRONT_API_KEY=""
# Additional exact browser origins for staging/admin mutations (comma-separated).
# Set explicitly for the CRM deployment's origin.
SECURITY_ALLOWED_ORIGINS="http://localhost:3000"
# Optional IP budgets: set ONLY after checking that the trusted proxy overwrites
# x-real-ip or appends the nearest client to x-forwarded-for, with no direct port access.
# Leave empty to use shared global/account/phone budgets without trusting caller IPs.
SECURITY_TRUSTED_IP_HEADER=""
# Production requires SECURITY_TRUSTED_IP_HEADER above OR this explicit
# acknowledgment (set to 1) that only global rate-limit buckets will exist, so
# one client can exhaust checkout/login budgets for everyone.
SECURITY_ACCEPT_GLOBAL_BUDGETS=""
# Dedicated live catalog skill credential (at least 32 characters; runtime only).
# Generate with: openssl rand -hex 32. Unset disables /api/catalog-agent/*.
CATALOG_AGENT_KEY=""
# Ozon Express (API key goes in the URL path — never commit, never log)
OZON_CLIENT_ID=""
OZON_API_KEY=""
OZON_BASE_URL="https://api.ozonexpress.ma"
OZON_USE_CUSTOM_TRACKING="0"
OZON_SUBMIT_INTERVAL_SEC="15" # anciens noms, toujours lus en repli
OZON_POLL_INTERVAL_MIN="30"
OZON_TRACK_BATCH="25"

# Transporteur : "mock", "ozon" ou "sendit" (valeur exacte). En mock, MOCK_COURIER_PROFILE imite "ozon" ou "sendit".
DELIVERY_PROVIDER="mock"
MOCK_COURIER_PROFILE="ozon"
SENDIT_PUBLIC_KEY=""
SENDIT_SECRET_KEY=""
COURIER_SUBMIT_INTERVAL_SEC="15"
COURIER_POLL_INTERVAL_MIN="30"
COURIER_TRACK_BATCH="25"
# Image uploads (default: <DB_PATH dir>/uploads; Compose fixes /app/data/uploads)
UPLOAD_DIR=""
# Optional server-side Meta integration; this CRM mounts no
# browser Pixel. Storefront browser pixels use IDs from store.config.ts and are
# deduplicated with these server events by event ID.
FACEBOOK_PIXEL_ID=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_TEST_EVENT_CODE=""
FACEBOOK_API_VERSION="v22.0"
# Admin-only, read-only CRM assistant (server-side runtime variables)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.7-flash"
# Optional server-side TikTok Events API (v1.3); disabled unless both ID and token are set.
# Pixel code (public, e.g. CXXXXXXXXXXXXXXXXXXX); the browser pixel uses the same
# kind of ID from store.config.ts and is deduplicated with server events by event ID.
TIKTOK_PIXEL_ID=""
# Events API access token (secret, server env only).
TIKTOK_ACCESS_TOKEN=""
# Optional test_event_code from TikTok Events Manager.
TIKTOK_TEST_EVENT_CODE=""
TIKTOK_API_BASE="https://business-api.tiktok.com/open_api/v1.3"

# Optional WhatsApp Assistant via self-hosted Evolution API v2 (inert unless configured).
# Private network URL (e.g. http://evolution:8080). HTTPS required unless loopback or private hostname.
EVOLUTION_BASE_URL=""
# Evolution API instance name (e.g. store slug).
EVOLUTION_INSTANCE=""
# Evolution API secret key (instance or global API key).
EVOLUTION_API_KEY=""
# Webhook secret (>= 32 random characters, used in path and x-webhook-secret header).
WHATSAPP_WEBHOOK_SECRET=""
# OpenRouter chat and fallback models (OPENROUTER_API_KEY above is reused).
# Default: z-ai/glm-5.3-flash
WHATSAPP_CHAT_MODEL=""
# Default: deepseek/deepseek-v4.1-flash
WHATSAPP_CHAT_FALLBACK_MODEL=""
# OpenRouter audio transcription and fallback models.
# Default: google/gemini-2.5-flash-lite
WHATSAPP_AUDIO_MODEL=""
# Default: qwen/qwen3.8-omni-flash
WHATSAPP_AUDIO_FALLBACK_MODEL=""

# Optional detailed /api/health (Bearer token, >= 32 chars; openssl rand -hex 32).
# Without it the public endpoint returns only {status, time}. Runtime secret.
HEALTH_DETAILS_TOKEN=""
# Log format: "json" (production default) or "pretty" (dev default). Optional.
LOG_FORMAT=""
# Set to "debug" to emit debug logs in production (otherwise suppressed). Optional.
LOG_LEVEL=""
# RECOVERY ONLY: set to 1 to boot despite an applied migration file whose checksum
# changed. Leave empty; see docs/operations.md before using it, then unset it.
MIGRATIONS_ALLOW_CHECKSUM_MISMATCH=""

# Backups (scripts/backup-db.mjs, read by the script only; it loads no env file).
# Destination directory (default: <DB_PATH dir>/backups).
BACKUP_DIR=""
# Number of backup sets to keep (integer >= 1, default 14).
BACKUP_RETENTION="14"
# Optional offsite copy through rclone, e.g. "remote:bucket/store". rclone must be
# installed and configured separately; its credentials never go in this file.
BACKUP_RCLONE_REMOTE=""

# Internal / framework-managed, do not set by hand: NODE_ENV, NEXT_RUNTIME,
# NEXT_PHASE, PORT, NEXT_PUBLIC_STORE_LOCALE (derived from store.config.ts),
# __NEXT_IMAGE_OPTS (injected by Next at build). STOREFRONT_API_KEY is the only
# storefront credential; there is no NEXT_PUBLIC_* secret.
